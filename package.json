{
  "name": "diff-cover-js",
  "version": "0.3.1",
  "description": "Diff coverage for JavaScript/TypeScript: line and branch coverage on changed lines only (patch coverage). Node.js alternative to Python diff-cover.",
  "license": "MIT",
  "author": {
    "name": "Samriddhi",
    "url": "https://github.com/samriddhi512"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samriddhi512/diff-cover-js.git"
  },
  "homepage": "https://samriddhi512.github.io/diff-cover-js/",
  "bugs": {
    "url": "https://github.com/samriddhi512/diff-cover-js/issues"
  },
  "keywords": [
    "coverage",
    "diff",
    "diff-cover",
    "diff-coverage",
    "changed-lines",
    "typescript",
    "branch-coverage",
    "code-coverage",
    "pull-request",
    "vitest",
    "istanbul",
    "nyc",
    "c8",
    "github-actions",
    "jest",
    "lcov",
    "test-coverage",
    "incremental-coverage",
    "patch-coverage",
    "ci"
  ],
  "bin": {
    "diff-cover-js": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "ts-node src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "parse-diff": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
