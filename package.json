{
  "name": "diff-cover-js",
  "version": "0.1.0",
  "description": "Diff-aware test coverage checker — JS/TS equivalent of Python diff-cover. Reports coverage only for lines you changed, not the whole file.",
  "license": "MIT",
  "author": {
    "name": "Samriddhi",
    "url": "https://github.com/samriddhi512"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/samriddhi512/diff-cover-js.git"
  },
  "homepage": "https://github.com/samriddhi512/diff-cover-js#readme",
  "bugs": {
    "url": "https://github.com/samriddhi512/diff-cover-js/issues"
  },
  "keywords": [
    "coverage",
    "diff",
    "diff-cover",
    "jest",
    "lcov",
    "test-coverage",
    "incremental-coverage",
    "patch-coverage",
    "ci"
  ],
  "bin": {
    "diff-cover-js": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "parse-diff": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
